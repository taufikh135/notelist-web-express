<header class="border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-900/90">
    <div class="container mx-auto flex max-w-4xl items-center justify-between p-4">
        <a href="/" class="text-xl font-semibold tracking-tight">MyNotes</a>

        <div class="flex items-center gap-3">
            <button
                type="button"
                id="themeToggle"
                class="rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
                aria-label="Toggle dark mode">
                <span id="themeLabel">Dark</span>
            </button>

            <div class="relative">
                <button
                    type="button"
                    id="avatarButton"
                    class="flex h-10 w-10 items-center justify-center rounded-full bg-black text-sm font-semibold text-white outline-none transition hover:bg-gray-800 focus:ring-2 focus:ring-gray-300 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200 dark:focus:ring-gray-700"
                    aria-expanded="false"
                    aria-haspopup="true">
                    AN
                </button>

                <div id="avatarMenu" class="absolute right-0 z-10 mt-2 hidden w-40 rounded-lg border border-gray-200 bg-white p-2 shadow-soft dark:border-gray-700 dark:bg-gray-900 dark:ring-1 dark:ring-gray-800">
                    <a href="/profile" class="block rounded px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 dark:text-gray-200 dark:hover:bg-gray-800">Profile</a>
                    <a href="/auth/logout" class="block rounded px-3 py-2 text-sm text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-950/40">Logout</a>
                </div>
            </div>
        </div>
    </div>
</header>
