<header class="border-b border-gray-200 bg-white/90 backdrop-blur dark:border-gray-800 dark:bg-gray-900/90">
    <div class="container mx-auto flex max-w-4xl items-center justify-between p-4">
        <a href="/auth/login" class="text-xl font-semibold tracking-tight">MyNotes</a>

        <div class="flex items-center gap-3">
            <button
                type="button"
                id="themeToggle"
                class="rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700"
                aria-label="Toggle dark mode"
            >
                <span id="themeLabel">Dark</span>
            </button>
            <span class="rounded-full border border-gray-200 bg-gray-50 px-3 py-1 text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">Sign in</span>
        </div>
    </div>
</header>
