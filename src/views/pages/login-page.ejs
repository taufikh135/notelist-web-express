<%- include("../partials/alert") %>
<main class="container mx-auto flex max-w-4xl items-center justify-center p-4 py-12 sm:py-20">
    <section class="w-full max-w-md rounded-lg bg-white p-6 shadow-soft dark:bg-gray-900 dark:ring-1 dark:ring-gray-800">
        <div class="mb-6">
            <h1 class="text-2xl font-semibold">Login</h1>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Access your notes with your email and password.</p>
        </div>

        <form action="/auth/login" method="POST" class="space-y-4">
            <div>
                <label for="email" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    value="<%= messages.email ?? '' %>"
                    placeholder="you@example.com"
                    class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:focus:border-gray-100 dark:focus:ring-gray-800"
                    required />
            </div>

            <div>
                <label for="password" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Password</label>
                <input
                    id="password"
                    name="password"
                    type="password"
                    value="<%= messages.password ?? '' %>"
                    placeholder="Enter your password"
                    class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:focus:border-gray-100 dark:focus:ring-gray-800"
                    required />
            </div>

            <div>
                <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300">
                    <input type="checkbox" name="remember" class="h-4 w-4 rounded border-gray-300 text-black focus:ring-gray-200 dark:border-gray-700 dark:bg-gray-950 dark:focus:ring-gray-800" />
                    Remember me
                </label>
            </div>

            <button type="submit" class="w-full rounded bg-black px-4 py-2 text-white transition hover:bg-gray-800">Login</button>

            <div class="flex items-center justify-between gap-3 pt-1 text-sm">
                <a href="/auth/forgot-password" class="text-gray-600 transition hover:text-black dark:text-gray-400 dark:hover:text-white">Forgot password?</a>
                <a href="/auth/register" class="font-medium text-gray-700 transition hover:text-black dark:text-gray-200 dark:hover:text-white">Create account</a>
            </div>
        </form>
    </section>
</main>
