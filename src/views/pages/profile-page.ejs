<%- include("../partials/alert") %>

<main class="container mx-auto flex max-w-4xl items-center justify-center p-4 py-8">
    <section class="w-full max-w-2xl rounded-lg bg-white p-6 shadow-soft dark:bg-gray-900 dark:ring-1 dark:ring-gray-800">
        <div class="mb-6">
            <h1 class="text-2xl font-semibold">Profile Settings</h1>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Update your account information and sign out when needed.</p>
        </div>

        <form action="/profile/update" method="POST" class="space-y-4">
            <div>
                <label for="name" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Name</label>
                <input
                    id="name"
                    name="name"
                    type="text"
                    value="<%= user.name %>"
                    class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:focus:border-gray-100 dark:focus:ring-gray-800" />
            </div>

            <div>
                <label for="email" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                <input
                    id="email"
                    name="email"
                    type="email"
                    value="<%= user.email %>"
                    class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-sm outline-none transition focus:border-gray-900 focus:ring-2 focus:ring-gray-200 dark:border-gray-700 dark:bg-gray-950 dark:text-gray-100 dark:focus:border-gray-100 dark:focus:ring-gray-800" />
            </div>

            <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:justify-between">
                <button type="submit" class="rounded bg-black px-4 py-2 text-white transition hover:bg-gray-800 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-200">Save Changes</button>
            </div>
        </form>
    </section>
</main>
